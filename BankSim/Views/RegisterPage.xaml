<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BankSim.ViewModels"
             x:Class="BankSim.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Inscription">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="14"
                             MaximumWidthRequest="420"
                             VerticalOptions="Center">

            <Label Text="Créer un compte" FontSize="28" FontAttributes="Bold"
                   HorizontalOptions="Center" Margin="0,0,0,10" />

            <Label Text="Nom complet" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" Placeholder="Votre nom" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" Keyboard="Email"
                   Placeholder="exemple@mail.com" />

            <Label Text="Mot de passe" FontAttributes="Bold" />
            <Entry Text="{Binding Password}" IsPassword="True"
                   Placeholder="8 caractères minimum" />

            <Label Text="Confirmer le mot de passe" FontAttributes="Bold" />
            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" />

            <Button Text="S'inscrire" Command="{Binding RegisterCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Message}" TextColor="Red"
                   HorizontalOptions="Center" />

            <Button Text="Déjà un compte ? Se connecter"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>