<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BankSim.ViewModels"
             x:Class="BankSim.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Inscription"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout>

            <!-- En-tête -->
            <Border Style="{StaticResource HeaderBox}" Padding="24,64,24,48">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Créer un compte" Style="{StaticResource HeaderTitle}"
                           FontSize="30" HorizontalOptions="Center" />
                    <Label Text="Rejoignez BankSim en quelques secondes"
                           Style="{StaticResource HeaderSubtitle}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Formulaire -->
            <Border Style="{StaticResource Card}" Margin="20,-18,20,24"
                    MaximumWidthRequest="420">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Nom complet" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Entry Text="{Binding Name}" Placeholder="Votre nom" />
                    </Border>

                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Entry Text="{Binding Email}" Keyboard="Email"
                               Placeholder="exemple@mail.com" />
                    </Border>

                    <Label Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Entry Text="{Binding Password}" IsPassword="True"
                               Placeholder="8 caractères minimum" />
                    </Border>

                    <Label Text="Confirmer le mot de passe" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBox}">
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True"
                               Placeholder="••••••••" />
                    </Border>

                    <Button Text="S'inscrire" Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,16,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Teal}" />
                    <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}" />

                    <Button Text="Déjà un compte ? Se connecter"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource LinkButton}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>