<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BankSim.ViewModels"
             x:Class="BankSim.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Connexion"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="14"
                             MaximumWidthRequest="420"
                             VerticalOptions="Center">

            <Label Text="BankSim" FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Connectez-vous à votre compte"
                   HorizontalOptions="Center" Margin="0,0,0,10" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" Keyboard="Email"
                   Placeholder="exemple@mail.com" />

            <Label Text="Mot de passe" FontAttributes="Bold" />
            <Entry Text="{Binding Password}" IsPassword="True"
                   Placeholder="••••••••" />

            <Button Text="Se connecter" Command="{Binding LoginCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Message}" TextColor="Red"
                   HorizontalOptions="Center" />

            <Button Text="Pas de compte ? S'inscrire"
                    Command="{Binding GoToRegisterCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>