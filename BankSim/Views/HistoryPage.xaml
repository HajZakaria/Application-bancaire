<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BankSim.ViewModels"
             x:Class="BankSim.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Historique">
    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12"
          MaximumWidthRequest="700">

        <Picker Title="Compte"
                ItemsSource="{Binding Accounts}"
                SelectedItem="{Binding SelectedAccount}" />

        <Label Grid.Row="1" Text="{Binding Message}" TextColor="Red"
               IsVisible="{Binding Message, Converter={x:Null}}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}">
            <CollectionView.EmptyView>
                <Label Text="Aucune transaction pour ce compte."
                       HorizontalOptions="Center" Margin="0,30" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransactionRow">
                    <Border Padding="14" Margin="0,0,0,8"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource Gray300}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding Details}" FontSize="13" />
                            <Label Grid.Row="2" Text="{Binding DateText}" FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                            <Label Grid.Column="1" Grid.RowSpan="3"
                                   Text="{Binding AmountText}"
                                   TextColor="{Binding AmountColor}"
                                   FontSize="17" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>